# Connection string do Neon (Dashboard → Connect → "Pooled connection").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Segredo para assinar as sessões. Gera um com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL público da app (no Vercel: https://<projeto>.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
