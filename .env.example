# Connection string do Neon (Dashboard → Connect → "Pooled connection").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth: Neon Console → o teu projeto → Auth → copia o "Auth URL".
NEON_AUTH_BASE_URL=https://<copia-o-auth-url-da-consola-do-neon>

# Segredo para assinar os cookies de sessão (mínimo 32 caracteres).
# Gera um com: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
